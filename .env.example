# Copy this file to .env.local and fill in the values (`vp run setup` does it for you).
# Never commit .env.local, and never prefix secrets with NEXT_PUBLIC_.

# The password everyone uses to log in (at least 4 characters).
# "test" is fine on your computer; choose a stronger one before deploying.
APP_PASSWORD=test

# Signs the login cookie. `vp run setup` generates one.
SESSION_SECRET=

# Needed to save posts and comments. Use one of:
#   Local Docker (`vp run db:up`): postgresql://postgres:postgres@localhost:55433/postgres
#   Supabase: Connect > Transaction pooler (port 6543)
DATABASE_URL=
